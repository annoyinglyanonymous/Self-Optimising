# Copy to .env and fill in. Values shown are reasonable defaults; keys with no
# default are required. See README.md "Setup" for the same list with prose.

# --- Required ---------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/outreach
OPENAI_API_KEY=sk-...
APP_ENV=development

# --- Auth -------------------------------------------------------------------
# Flip AUTH_REQUIRED=true once login is wired. JWT_SECRET must be a long random
# string when AUTH_REQUIRED=true; the app raises at startup otherwise.
AUTH_REQUIRED=false
JWT_SECRET=
JWT_EXPIRES_HOURS=24

# Encryption key for app_settings rows marked is_secret (e.g. sender creds).
# Required when any secret setting is configured. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# --- Bandit / safety --------------------------------------------------------
EXPLORATION_RATE=0.12
MIN_BANDIT_TRIALS=50
MAX_BOUNCE_RATE=0.03
MAX_SPAM_RATE=0.001

# --- Scheduler --------------------------------------------------------------
# Off by default. Enable only after a real sender backend is configured,
# otherwise the loop generates drafts that never ship.
SCHEDULER_ENABLED=false
SCHEDULER_INTERVAL_MINUTES=10
SCHEDULER_BATCH_SIZE=10

# --- Sender -----------------------------------------------------------------
# One of: stub | gmail | instantly. `stub` writes touches but doesn't send,
# safe for local dev. Per-backend credentials below; only the active backend's
# fields are used.
SENDER_BACKEND=stub

# Gmail (SMTP via app password)
GMAIL_USERNAME=
GMAIL_APP_PASSWORD=
GMAIL_FROM_ADDRESS=
GMAIL_FROM_NAME=

# Instantly
INSTANTLY_API_KEY=
INSTANTLY_API_BASE_URL=https://api.instantly.ai/api/v2
INSTANTLY_DEFAULT_CAMPAIGN_ID=
